# QuantumDesk (frontend) — environment example
# Copy to `.env` and fill in real values. NEVER commit a real `.env` file.
# All values here are PUBLIC (NEXT_PUBLIC_* is inlined into the browser bundle).
# Placeholders only — no secrets belong in this file.

# Base URL of the be-quantumLeap API, without a trailing slash.
# Read by src/lib/api.js and src/components/PostForm.jsx.
# Canonical variable name; the legacy names below are kept only until
# TASK-07-02 unifies them on this one variable.
NEXT_PUBLIC_API_BASE=http://localhost:7000

# --- Legacy aliases (still read by source today) ---
# Read by src/app/sitemap.js only. Set it to the same value as
# NEXT_PUBLIC_API_BASE until TASK-07-02 removes it.
NEXT_PUBLIC_BE_API_URL=http://localhost:7000

# Read by src/lib/socket.js only. Set it to the same value as
# NEXT_PUBLIC_API_BASE until TASK-07-02 removes it.
NEXT_PUBLIC_BASE_URL=http://localhost:7000
